# Mac dinh: ty nhien xuong dong LF khi commit
* text=auto eol=lf

# Script shell/phai LF - neu mang CRLF, Debian bao "bash\r: No such file or directory"
*.sh   text eol=lf
*.bash text eol=lf
Makefile text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.ini  text eol=lf
*.cfg  text eol=lf

# PowerShell chay tren Windows cua Hung: CRLF la dung
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Nhi pham lab khong bao gio duoc commit (giu dong bao ve thu 2 sau .gitignore)
*.vmdk binary
*.vmx  binary
*.iso  binary
*.png  binary
*.jpg  binary
*.pdf  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text

# Danh dau file sinh tu de khong bao gio review oan
evidence/derived/** linguist-generated=true
docs/evidence-index.md linguist-generated=true
